@apiBase = http://localhost:8080
@seedEmail = admin@test.com
@seedPassword = Admin123!
@runId = {{$timestamp}}

### Login seed admin
# @name login
POST {{apiBase}}/api/auth/login
Content-Type: application/json

{
  "email": "{{seedEmail}}",
  "password": "{{seedPassword}}"
}

### Create customer valid
# @name createCustomer
POST {{apiBase}}/api/customers
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "fullName": "Maria Perez {{runId}}",
  "phone": "8095550102",
  "email": "maria.{{runId}}@colmado.local"
}

### List customers for current BusinessId
GET {{apiBase}}/api/customers?page=1&pageSize=10&query=Maria&sortBy=name&sortDirection=asc
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Get customer by id
GET {{apiBase}}/api/customers/{{createCustomer.response.body.$.data.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Update customer valid
PUT {{apiBase}}/api/customers/{{createCustomer.response.body.$.data.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "fullName": "Maria Perez Actualizada {{runId}}",
  "phone": "8095550103",
  "email": "maria.actualizada.{{runId}}@colmado.local",
  "isActive": true
}

### Delete customer
DELETE {{apiBase}}/api/customers/{{createCustomer.response.body.$.data.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Create invalid customer; expected 400 VALIDATION_ERROR
POST {{apiBase}}/api/customers
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "fullName": "",
  "phone": "8095550104",
  "email": "invalid-customer.{{runId}}@colmado.local"
}

### Endpoint protected without token; expected 401 UNAUTHORIZED
GET {{apiBase}}/api/customers
