@apiBase = http://localhost:8080
@seedEmail = admin@test.com
@seedPassword = Admin123!
@seedBranchId = 22222222-2222-2222-2222-222222222222
@runId = {{$timestamp}}

### Login seed admin
# @name login
POST {{apiBase}}/api/auth/login
Content-Type: application/json

{
  "email": "{{seedEmail}}",
  "password": "{{seedPassword}}"
}

### Create product for sale
# @name createSaleProduct
POST {{apiBase}}/api/catalog/products
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "productType": "Simple",
  "name": "Aceite 16 oz {{runId}}",
  "description": "Producto temporal para ventas HTTP",
  "sku": "ACEITE-SALE-{{runId}}",
  "barcode": "882{{runId}}",
  "categoryId": null,
  "brandId": null,
  "unitOfMeasure": "Unit",
  "salePrice": 125.00,
  "costPrice": 80.00,
  "wholesalePrice": null,
  "minSalePrice": null,
  "taxCategory": "Itbis18",
  "taxRate": 18.0,
  "isTaxIncluded": true,
  "allowsDiscount": true,
  "trackInventory": true,
  "minimumStock": 5,
  "maximumStock": 100,
  "reorderPoint": 10,
  "allowNegativeStock": false,
  "internalCode": null,
  "supplierCode": null,
  "parentProductId": null,
  "variantName": null,
  "attributesJson": null
}

### Add stock before example sales (10 units)
POST {{apiBase}}/api/inventory/adjustments
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "productId": "{{createSaleProduct.response.body.$.data.id}}",
  "quantity": 10,
  "reason": "Stock inicial para ejemplo de ventas",
  "branchId": "{{seedBranchId}}"
}

# ─── Ejemplo: 3 órdenes con distintos métodos de pago ────────────────────────
# Orden 1 – Efectivo (Cash)
# Orden 2 – Transferencia (Transfer)
# Orden 3 – Tarjeta (Card)
# Sirve para validar el filtro ?paymentMethod= en GET /api/sales

### Orden 1 – Efectivo; expected 201 Created, status Received
# @name createSale
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "{{createSaleProduct.response.body.$.data.id}}",
      "quantity": 2
    }
  ]
}

### Orden 2 – Transferencia; expected 201 Created, status Received
# @name createSale2
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Transfer",
  "items": [
    {
      "productId": "{{createSaleProduct.response.body.$.data.id}}",
      "quantity": 3
    }
  ]
}

### Orden 3 – Tarjeta; expected 201 Created, status Received
# @name createSale3
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Card",
  "items": [
    {
      "productId": "{{createSaleProduct.response.body.$.data.id}}",
      "quantity": 1
    }
  ]
}

### List sales for current BusinessId
GET {{apiBase}}/api/sales?page=1&pageSize=10&sortBy=createdAt&sortDirection=desc
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Filtrar solo ventas por Efectivo; expected solo la Orden 1
GET {{apiBase}}/api/sales?paymentMethod=Cash&pageSize=25
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Filtrar solo ventas por Transferencia; expected solo la Orden 2
GET {{apiBase}}/api/sales?paymentMethod=Transfer&pageSize=25
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Filtrar solo ventas por Tarjeta; expected solo la Orden 3
GET {{apiBase}}/api/sales?paymentMethod=Card&pageSize=25
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Get sale by id
GET {{apiBase}}/api/sales/{{createSale.response.body.$.data.saleId}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Create sale without items; expected 400 VALIDATION_ERROR
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Cash",
  "items": []
}

### Create sale with quantity 0; expected 400 VALIDATION_ERROR
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "{{createSaleProduct.response.body.$.data.id}}",
      "quantity": 0
    }
  ]
}

### Create sale with nonexistent product; expected 404 PRODUCT_NOT_FOUND
POST {{apiBase}}/api/sales
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "branchId": "{{seedBranchId}}",
  "customerId": null,
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "00000000-0000-0000-0000-000000000001",
      "quantity": 1
    }
  ]
}

### Cancel sale while cancellable
POST {{apiBase}}/api/sales/{{createSale.response.body.$.data.saleId}}/cancel
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "reason": "Cliente cambio la compra"
}

### Endpoint protected without token; expected 401 UNAUTHORIZED
GET {{apiBase}}/api/sales
